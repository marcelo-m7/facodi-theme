<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="published_courses_filter" model="ir.filters">
            <field name="name">FACODI Public eLearning Courses</field>
            <field name="model_id">slide.channel</field>
            <field name="user_ids" eval="False"/>
            <field name="domain">[('visibility', 'in', ['public', 'connected'])]</field>
            <field name="sort">["published_date desc"]</field>
            <field name="action_id" ref="website.action_website"/>
        </record>
        <record id="dynamic_filter_published_courses" model="website.snippet.filter">
            <field name="filter_id" ref="theme_facodi.published_courses_filter"/>
            <field name="field_names">name,description_short,total_slides,website_url</field>
            <field name="limit" eval="6"/>
            <field name="name">FACODI Published Courses</field>
        </record>
    </data>
</odoo>
