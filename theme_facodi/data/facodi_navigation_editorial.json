    {
      "url": "/about",
      "name": "About FACODI",
      "view_key": "website.about-facodi",
      "arch_db": "<t name=\"About FACODI\" t-name=\"website.facodi_about\">\n  <t t-call=\"website.layout\">\n    <div id=\"wrap\" class=\"oe_structure facodi-about-stable\">\n      <style>\n        .facodi-about-stable{\n          --fa-ink:#142846;--fa-cyan:#37BED2;--fa-blue:#3979C8;--fa-mint:#A7E8BE;--fa-sun:#EFFF00;--fa-paper:#F9FAFB;\n          background:var(--fa-paper);color:var(--fa-ink);max-width:100%;overflow-x:clip;touch-action:pan-y;overscroll-behavior-x:none;\n        }\n        .facodi-about-stable,.facodi-about-stable *{box-sizing:border-box;min-width:0}\n        .facodi-about-stable img,.facodi-about-stable video,.facodi-about-stable iframe{display:block;max-width:100%;height:auto}\n        .facodi-about-stable a,.facodi-about-stable p,.facodi-about-stable h1,.facodi-about-stable h2,.facodi-about-stable h3{overflow-wrap:anywhere}\n        .fa-shell{width:min(1180px,calc(100% - 32px));margin:0 auto}\n        .fa-section{padding:clamp(2.5rem,6vw,5.5rem) 0;overflow:clip}\n        .fa-grid-bg{background-image:linear-gradient(rgba(20,40,70,.08) 1px,transparent 1px),linear-gradient(90deg,rgba(20,40,70,.08) 1px,transparent 1px);background-size:28px 28px}\n        .fa-hero{background:var(--fa-ink);color:white;border:2px solid var(--fa-ink);border-radius:24px;box-shadow:8px 8px 0 var(--fa-sun);padding:clamp(1.5rem,5vw,4rem)}\n        .fa-hero h1,.fa-hero p,.fa-cta h2,.fa-cta p{color:white!important}\n        .fa-kicker{display:inline-flex;align-items:center;background:var(--fa-sun);color:var(--fa-ink)!important;border:1px solid var(--fa-ink);border-radius:8px;padding:.36rem .58rem;font:800 .75rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.04em;text-transform:uppercase}\n        .fa-title{font-size:clamp(2.45rem,6vw,5.5rem);line-height:.96;max-width:12ch;margin:1rem 0 1.25rem}\n        .fa-lead{font-size:clamp(1.05rem,1.7vw,1.28rem);line-height:1.6;max-width:48rem}\n        .fa-actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:1.5rem}\n        .fa-btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;border:2px solid var(--fa-ink);border-radius:10px;padding:.75rem 1rem;font-weight:800;text-decoration:none}\n        .fa-btn-primary{background:var(--fa-sun);color:var(--fa-ink)!important}\n        .fa-btn-secondary{background:white;color:var(--fa-ink)!important}\n        .fa-eyebrow{font:800 .78rem/1.1 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.06em;text-transform:uppercase;color:var(--fa-blue)}\n        .fa-heading{font-size:clamp(2rem,4vw,3.4rem);line-height:1.02;max-width:16ch;margin:.7rem 0 1rem}\n        .fa-copy{font-size:1.05rem;line-height:1.7;max-width:68ch}\n        .fa-two{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(280px,.75fr);gap:clamp(1.2rem,3vw,2.5rem);align-items:start}\n        .fa-three{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}\n        .fa-four{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}\n        .fa-card{background:white;border:2px solid var(--fa-ink);border-radius:18px;box-shadow:5px 5px 0 var(--fa-ink);padding:1.35rem;height:100%}\n        .fa-card-cyan{box-shadow:5px 5px 0 var(--fa-cyan)}\n        .fa-card-mint{box-shadow:5px 5px 0 var(--fa-mint)}\n        .fa-card-sun{box-shadow:5px 5px 0 var(--fa-sun)}\n        .fa-card h3{margin-bottom:.7rem}\n        .fa-step{display:grid;grid-template-columns:44px minmax(0,1fr);gap:1rem;align-items:start}\n        .fa-step-n{width:44px;height:44px;display:flex;align-items:center;justify-content:center;background:var(--fa-sun);border:2px solid var(--fa-ink);border-radius:10px;font-weight:900}\n        .fa-divider{border-top:2px solid var(--fa-ink)}\n        .fa-cta{background:var(--fa-ink);color:white;border:2px solid var(--fa-ink);border-radius:22px;box-shadow:6px 6px 0 var(--fa-sun);padding:clamp(1.5rem,4vw,3rem)}\n        .fa-cta-grid{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(220px,.5fr);gap:1.5rem;align-items:center}\n        .fa-list{margin:0;padding-left:1.2rem}\n        .fa-list li+li{margin-top:.65rem}\n        @media(max-width:900px){.fa-two,.fa-three,.fa-four,.fa-cta-grid{grid-template-columns:1fr}.fa-title{max-width:14ch}.fa-shell{width:min(100% - 24px,1180px)}}\n        @media(max-width:600px){.fa-section{padding:2.25rem 0}.fa-hero,.fa-cta{border-radius:16px;box-shadow:5px 5px 0 var(--fa-sun)}.fa-actions{flex-direction:column}.fa-btn{width:100%}.fa-title{font-size:clamp(2.2rem,13vw,3.8rem)}}\n      </style>\n\n      <section class=\"fa-section fa-grid-bg\">\n        <div class=\"fa-shell\">\n          <div class=\"fa-hero\">\n            <span class=\"fa-kicker\">About FACODI</span>\n            <h1 class=\"fa-title\">Open learning with enough context to keep the thread.</h1>\n            <p class=\"fa-lead\">FACODI organises public courses, videos and open learning resources into clearer study paths. The goal is simple: make it easier to study, discover useful connections and contribute good resources without confusing curricular context with formal academic recognition.</p>\n            <div class=\"fa-actions\">\n              <a class=\"fa-btn fa-btn-primary\" href=\"/courses\">Explore courses</a>\n              <a class=\"fa-btn fa-btn-secondary\" href=\"/submissions/new?type=resource&amp;source=about_resource_cta&amp;section=about\">Contribute a resource</a>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"fa-section\">\n        <div class=\"fa-shell fa-two\">\n          <div>\n            <div class=\"fa-eyebrow\">Why it exists</div>\n            <h2 class=\"fa-heading\">Too many useful tabs. Not enough map.</h2>\n            <p class=\"fa-copy\">FACODI grew from a familiar study habit: learning from excellent public lectures, videos, documentation and open materials spread across the web, then losing the relationship between them.</p>\n            <p class=\"fa-copy\">The platform organises those resources around courses, curricular topics and learning paths so a useful link becomes part of a useful learning context.</p>\n          </div>\n          <aside class=\"fa-card fa-card-cyan\">\n            <div class=\"fa-eyebrow\">Important boundary</div>\n            <h3 class=\"h4 mt-3\">Context is not equivalence.</h3>\n            <p class=\"mb-0\">Curricular references help navigation. They do not create ECTS, academic equivalence or a formal qualification.</p>\n          </aside>\n        </div>\n      </section>\n\n      <section class=\"fa-section fa-grid-bg fa-divider\">\n        <div class=\"fa-shell\">\n          <div class=\"fa-eyebrow\">Principles</div>\n          <h2 class=\"fa-heading\">How FACODI decides what belongs.</h2>\n          <div class=\"fa-three\">\n            <article class=\"fa-card fa-card-sun\">\n              <h3 class=\"h4\">01 · Open first</h3>\n              <p class=\"mb-0\">Prefer resources people can actually open, revisit and share.</p>\n            </article>\n            <article class=\"fa-card fa-card-mint\">\n              <h3 class=\"h4\">02 · Context first</h3>\n              <p class=\"mb-0\">A resource is more useful when learners can see the course, topic or question it supports.</p>\n            </article>\n            <article class=\"fa-card fa-card-cyan\">\n              <h3 class=\"h4\">03 · Clear states</h3>\n              <p class=\"mb-0\">Community sharing, editorial review and curated publication are different states and should remain visible.</p>\n            </article>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"facodi-curation-flow\" class=\"fa-section\" aria-labelledby=\"facodi-curation-title\"><style>\n#facodi-curation-flow{background:var(--fa-paper);color:var(--fa-ink);overflow:clip}\n#facodi-curation-flow .fa-curation-shell{width:min(1180px,calc(100% - 32px));margin:auto}\n#facodi-curation-flow .fa-curation-title{font-size:clamp(2rem,4vw,3.4rem);line-height:1.05;color:var(--fa-ink);max-width:19ch;margin:.7rem 0 1rem;font-weight:850}\n#facodi-curation-flow .fa-curation-lead{font-size:1.08rem;line-height:1.65;color:var(--fa-ink);opacity:.8;max-width:64ch;margin-bottom:2rem}\n#facodi-curation-flow .fa-curation-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem}\n#facodi-curation-flow .fa-curation-card{position:relative;min-width:0;min-height:215px;padding:1.3rem;background:#fff;border:2px solid var(--fa-ink);border-radius:18px;box-shadow:5px 5px 0 var(--fa-cyan);color:var(--fa-ink)}\n#facodi-curation-flow .fa-curation-card:nth-child(3n+2){box-shadow:5px 5px 0 var(--fa-mint)}\n#facodi-curation-flow .fa-curation-card:nth-child(3n){box-shadow:5px 5px 0 var(--fa-sun)}\n#facodi-curation-flow .fa-curation-num{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;background:var(--fa-sun);border:2px solid var(--fa-ink);border-radius:10px;font-weight:900}\n#facodi-curation-flow .fa-curation-symbol{position:absolute;right:1.25rem;top:1.25rem;font-size:1.4rem;color:var(--fa-blue)}\n#facodi-curation-flow h3{font-size:1.1rem;line-height:1.25;font-weight:800;margin:1.25rem 0 .6rem;color:var(--fa-ink);text-transform:none}\n#facodi-curation-flow .fa-curation-card p{font-size:.97rem;line-height:1.6;color:var(--fa-ink);opacity:.84;margin:0}\n#facodi-curation-flow .fa-curation-next{position:absolute;right:-21px;top:48%;z-index:2;background:var(--fa-paper);border-radius:6px;padding:0 3px;color:var(--fa-ink);font-size:1.5rem}\n#facodi-curation-flow .fa-curation-note{margin-top:2rem;max-width:75ch;line-height:1.65}\n#facodi-curation-flow .fa-curation-note a{color:var(--fa-blue);font-weight:800;text-underline-offset:3px}\n@media(min-width:1200px){#facodi-curation-flow .fa-curation-grid{grid-template-columns:repeat(3,minmax(0,1fr))}}\n@media(max-width:900px){#facodi-curation-flow .fa-curation-grid{grid-template-columns:repeat(2,minmax(0,1fr))}#facodi-curation-flow .fa-curation-next{display:none}}\n@media(max-width:600px){#facodi-curation-flow .fa-curation-grid{grid-template-columns:1fr}#facodi-curation-flow .fa-curation-card{min-height:0}#facodi-curation-flow .fa-curation-title{max-width:none}}\n</style><div class=\"fa-curation-shell\"><p class=\"fa-eyebrow\">Editorial workflow</p><h2 id=\"facodi-curation-title\" class=\"fa-curation-title\">From link to learning path</h2><p class=\"fa-curation-lead\">A human editorial process that turns an isolated video into meaningful learning.</p><div class=\"fa-curation-grid\"><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">01</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">↗</span><h3>Link received</h3><p>We receive the video link and check whether it is useful learning material.</p><span class=\"fa-curation-next\" aria-hidden=\"true\">→</span></article><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">02</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">◎</span><h3>Quick curation</h3><p>A first pass gathers summary, language, tags and category without relying on external AI.</p><span class=\"fa-curation-next\" aria-hidden=\"true\">→</span></article><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">03</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">▱</span><h3>Categorisation</h3><p>The resource gains a topic, context and a place where learners can find it.</p><span class=\"fa-curation-next\" aria-hidden=\"true\">→</span></article><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">04</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">⌕</span><h3>Deep analysis</h3><p>The second-stage analysis may run later, without blocking the initial submission.</p><span class=\"fa-curation-next\" aria-hidden=\"true\">→</span></article><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">05</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">✎</span><h3>Editorial review</h3><p>People verify and refine the summary, categories, tags and curricular relevance.</p><span class=\"fa-curation-next\" aria-hidden=\"true\">→</span></article><article class=\"fa-curation-card\"><span class=\"fa-curation-num\">06</span><span class=\"fa-curation-symbol\" aria-hidden=\"true\">⚑</span><h3>Learning pathway</h3><p>Once appropriate, the resource joins relevant pathways and collections.</p></article></div><p class=\"fa-curation-note\">Community submission, automated processing and editorial approval are distinct stages. Deep analysis can happen asynchronously; inclusion in a learning path depends on review and relevance. <a href=\"/submissions/new?type=resource&amp;source=about_curation_flow\">Suggest a resource</a>.</p></div></section>\n      <section id=\"how-it-works\" class=\"fa-section\">\n        <div class=\"fa-shell\">\n          <div class=\"fa-eyebrow\">How it works</div>\n          <h2 class=\"fa-heading\">From one question to one useful next step.</h2>\n          <div class=\"fa-four\">\n            <article class=\"fa-card\"><div class=\"fa-step\"><div class=\"fa-step-n\">1</div><div><h3 class=\"h5\">Choose a starting point</h3><p class=\"mb-0\">A course, topic, curricular unit or a very specific question.</p></div></div></article>\n            <article class=\"fa-card\"><div class=\"fa-step\"><div class=\"fa-step-n\">2</div><div><h3 class=\"h5\">Explore open resources</h3><p class=\"mb-0\">Use the links that genuinely help you move forward.</p></div></div></article>\n            <article class=\"fa-card\"><div class=\"fa-step\"><div class=\"fa-step-n\">3</div><div><h3 class=\"h5\">Connect content to context</h3><p class=\"mb-0\">Relate resources to the learning path so they do not remain isolated.</p></div></div></article>\n            <article class=\"fa-card\"><div class=\"fa-step\"><div class=\"fa-step-n\">4</div><div><h3 class=\"h5\">Leave something useful behind</h3><p class=\"mb-0\">Share a resource, correction or gap with enough context to help the next learner.</p></div></div></article>\n          </div>\n        </div>\n      </section>\n\n      <section class=\"fa-section fa-divider\">\n        <div class=\"fa-shell fa-two\">\n          <div>\n            <div class=\"fa-eyebrow\">What you can do here</div>\n            <h2 class=\"fa-heading\">Study, connect and contribute.</h2>\n            <ul class=\"fa-list fa-copy\">\n              <li>Browse open courses and community-shared resources.</li>\n              <li>Move between courses, learning paths and curricular context.</li>\n              <li>Share a public resource without pretending it is already curated.</li>\n              <li>Report gaps, corrections and useful context for the next learner.</li>\n            </ul>\n          </div>\n          <aside class=\"fa-card fa-card-mint\">\n            <div class=\"fa-eyebrow\">Open campus</div>\n            <h3 class=\"h4 mt-3\">Still under construction, by design.</h3>\n            <p class=\"mb-0\">FACODI is a living community platform. Public resources can appear quickly, while editorial curation remains a separate layer.</p>\n          </aside>\n        </div>\n      </section>\n\n      <section class=\"fa-section\">\n        <div class=\"fa-shell\">\n          <div class=\"fa-cta\">\n            <div class=\"fa-cta-grid\">\n              <div>\n                <span class=\"fa-kicker\">Build the trail</span>\n                <h2 class=\"display-5 mt-3 mb-3\">Useful resources should not disappear into browser history.</h2>\n                <p class=\"fa-lead mb-0\">Explore what is already public or contribute a resource that deserves a place in the learning map.</p>\n              </div>\n              <div class=\"d-grid gap-2\">\n                <a class=\"fa-btn fa-btn-primary\" href=\"/courses\">Explore catalogue</a>\n                <a class=\"fa-btn fa-btn-secondary\" href=\"/submissions/new?type=resource&amp;source=about_resource_cta&amp;section=about\">Contribute a resource</a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <section id=\"academic-model\" class=\"fa-section fa-divider\"><div class=\"fa-shell\"><div class=\"fa-eyebrow\">Academic model</div><h2 class=\"fa-heading\">Curricular context is not academic equivalence.</h2><p class=\"fa-copy\">FACODI links open resources to official study plans and curricular units. Year, semester and ECTS are useful references, not an award of credits, equivalence or degrees.</p><div class=\"fa-actions\"><a class=\"fa-btn fa-btn-primary\" href=\"/curricular-units\">Curricular units</a><a class=\"fa-btn fa-btn-secondary\" href=\"/roadmaps\">Learning paths</a></div></div></section>\n      <section id=\"technology\" class=\"fa-section fa-divider\"><div class=\"fa-shell fa-two\"><div><div class=\"fa-eyebrow\">Platform and editorial process</div><h2 class=\"fa-heading\">From contribution to curated learning.</h2><p class=\"fa-copy\">FACODI brings together Odoo Website, eLearning, community submissions and editorial review. Resources are checked, enriched and classified before publication; people remain responsible for the final decision.</p></div><aside class=\"fa-card fa-card-cyan\"><h3 class=\"h4\">Editorial journey</h3><p>Suggest → Validate → Enrich → Review → Publish</p><a href=\"/submissions/new?type=resource&amp;source=about&amp;section=technology\">Suggest a resource</a></aside></div></section>\n      <section id=\"team\" class=\"fa-section fa-divider\"><div class=\"fa-shell fa-two\"><div><div class=\"fa-eyebrow\">People</div><h2 class=\"fa-heading\">Built around open learning.</h2><p class=\"fa-copy\">Initiated by Marcelo Santos, FACODI connects software engineering, open education and contributions from learners and collaborators.</p></div><aside class=\"fa-card fa-card-mint\"><h3 class=\"h4\">Our ecosystem</h3><p>Academic references, European student initiatives and technical collaborators.</p><a href=\"/partnerships\">Explore partnerships</a></aside></div></section>\n      <section id=\"next-steps\" class=\"fa-section fa-divider\"><div class=\"fa-shell\"><div class=\"fa-eyebrow\">Keep building</div><h2 class=\"fa-heading\">Discover, learn and contribute.</h2><p class=\"fa-copy\">More connected learning paths, clearer curricular coverage and a growing community of contributors.</p><div class=\"fa-actions\"><a class=\"fa-btn fa-btn-primary\" href=\"/explore\">Explore</a><a class=\"fa-btn fa-btn-secondary\" href=\"/partnerships\">Partners and collaborators</a></div></div></section>\n    </div>\n  </t>\n</t>"
    },
    {
      "url": "/partnerships",
      "name": "Partnerships",
      "view_key": "website.facodi_partnerships",
      "arch_db": "<t name=\"FACODI Partnerships\" t-name=\"website.facodi_partnerships\"><t t-call=\"website.layout\"><div id=\"wrap\" class=\"oe_structure\"><section class=\"facodi-section facodi-grid-paper py-5\"><div class=\"container\"><div class=\"facodi-sheet p-4 p-lg-5\"><p class=\"facodi-kicker\">FACODI / Ecosystem</p><h1>Partnerships &amp; collaborations</h1><p class=\"facodi-lead\">Open learning grows through institutions, community contributors and technical collaborators. Here is how each relationship helps the FACODI learning experience, without confusing curricular references with formal institutional endorsement.</p><div class=\"d-flex flex-wrap gap-2 mt-4\"><a class=\"btn btn-primary\" href=\"/about\">The Project</a><a class=\"btn btn-outline-primary\" href=\"/contact\">Get in touch</a></div></div></div></section><section class=\"py-5\"><div class=\"container\"><div class=\"row g-4\"><div class=\"col-lg-6\"><article class=\"facodi-sheet p-4 h-100\"><p class=\"facodi-kicker\">Academic context</p><h2>University of Algarve</h2><p>FACODI uses public curriculum references from the University of Algarve to organise open learning resources, including the LESTI study path. This helps learners discover content; it does not imply academic equivalence, ECTS recognition or institutional accreditation.</p><a class=\"btn btn-outline-primary\" href=\"/roadmaps\">Explore learning paths</a><p class=\"small mt-3 mb-0\">Official curriculum: <a href=\"https://www.ualg.pt/curso/1941/plano\" target=\"_blank\" rel=\"noopener noreferrer\">LESTI study plan</a></p></article></div><div class=\"col-lg-6\"><article class=\"facodi-sheet p-4 h-100\"><p class=\"facodi-kicker\">European learning community</p><h2>SEA-EU</h2><p>FACODI has been presented in the context of SEA-EU student-led initiatives. Our aim is to promote exchange around open resources and community curation without suggesting that every listed institution endorses individual FACODI courses.</p><a class=\"btn btn-outline-primary\" href=\"/blog\">Read updates</a></article></div><div class=\"col-lg-6\"><article class=\"facodi-sheet p-4 h-100\"><p class=\"facodi-kicker\">Technology &amp; community</p><h2>Contributors</h2><p>Open-source developers, educators and technical collaborators help improve publishing, accessibility and content discovery. Contributions and collaboration are acknowledged according to their verified role.</p><a class=\"btn btn-outline-primary\" href=\"/submissions/new?type=resource&amp;source=partnerships&amp;section=community\">Contribute a resource</a></article></div><div class=\"col-lg-6\"><article class=\"facodi-sheet p-4 h-100\"><p class=\"facodi-kicker\">Work with us</p><h2>Build the next learning trail</h2><p>Represent an institution, share open teaching material or want to support FACODI? We welcome clear proposals with attribution and responsible editorial review.</p><a class=\"btn btn-primary\" href=\"/contact\">Contact FACODI</a></article></div></div></div></section><section class=\"py-5\"><div class=\"container text-center\"><h2>Discover. Learn. Contribute.</h2><p>Explore the catalogue, understand the project and suggest a useful learning resource.</p><div class=\"d-flex justify-content-center flex-wrap gap-2\"><a href=\"/explore\" class=\"btn btn-outline-primary\">Explore</a><a href=\"/courses\" class=\"btn btn-primary\">Courses</a><a href=\"/about\" class=\"btn btn-outline-primary\">About FACODI</a></div></div></section></div></t></t>"
    }
  ],
