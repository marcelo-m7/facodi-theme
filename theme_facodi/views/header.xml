<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_header_facodi"
              inherit_id="website.layout"
              name="FACODI Header Template">
        <!--
            Replace the stable outer header rather than assuming that its current
            contents still contain a <nav>. Existing websites can carry Website
            Builder/header customizations which legitimately change that inner
            structure; targeting //header//nav made the selected FACODI template
            fail at QWeb render time on those databases.

            The replacement keeps Odoo's standard Website/Portal building blocks
            for logo, menus, submenus, account state and the mobile header.
        -->
        <xpath expr="//header" position="replace">
            <header t-if="not no_header"
                    id="top"
                    data-anchor="true"
                    data-name="Header"
                    t-att-data-extra-items-toggle-aria-label="extra_items_toggle_aria_label"
                    t-attf-class="#{header_bg_color_class} #{header_text_color_class} #{'d-none o_snippet_invisible' if 'header_visible' in main_object and not main_object.sudo().header_visible else ''}"
                    t-attf-style="#{header_bg_color_style and ('background-color: %s;' % header_bg_color_style)} #{header_text_color_style and ('color: %s;' % header_text_color_style)}"
                    t-att-data-invisible="'1' if 'header_visible' in main_object and not main_object.sudo().header_visible else None">
                <t t-call="website.navbar">
                    <t t-set="_navbar_classes" t-valuef="d-none d-lg-block facodi-header"/>
                    <t t-set="_navbar_name">Primary navigation</t>
                    <div id="o_main_nav" class="container-fluid facodi-nav-shell facodi-paper-nav">
                        <t t-call="website.placeholder_header_brand">
                            <t t-set="_link_class" t-valuef="facodi-wordmark"/>
                        </t>
                        <t t-call="website.navbar_nav">
                            <t t-set="_nav_class" t-valuef="ms-auto align-items-lg-center gap-lg-1"/>
                            <t t-foreach="website.menu_id.child_id" t-as="submenu">
                                <t t-if="submenu.is_visible and submenu.child_id.filtered(lambda menu: menu.is_visible) and submenu._facodi_landing_url()">
                                    <li class="nav-item dropdown facodi-nav-split">
                                        <a t-att-href="submenu._facodi_landing_url()"
                                           t-attf-class="nav-link facodi-nav-split-link #{submenu._is_active() and 'active'}"
                                           role="menuitem">
                                            <span t-field="submenu.name"/>
                                        </a>
                                        <button type="button"
                                                class="nav-link dropdown-toggle dropdown-toggle-split facodi-nav-split-toggle"
                                                data-bs-toggle="dropdown"
                                                data-bs-auto-close="outside"
                                                aria-expanded="false"
                                                aria-label="Open submenu">
                                            <span class="visually-hidden">Open submenu</span>
                                        </button>
                                        <ul class="dropdown-menu facodi-dropdown-menu" role="menu">
                                            <t t-foreach="submenu.child_id" t-as="submenu">
                                                <t t-call="website.submenu"
                                                   item_class="None"
                                                   link_class.f="dropdown-item"/>
                                            </t>
                                        </ul>
                                    </li>
                                </t>
                                <t t-else="">
                                    <t t-call="website.submenu">
                                        <t t-set="item_class" t-valuef="nav-item"/>
                                        <t t-set="link_class" t-valuef="nav-link"/>
                                        <t t-set="dropdown_menu_classes" t-valuef="facodi-dropdown-menu"/>
                                    </t>
                                </t>
                            </t>
                            <t t-call="website.placeholder_header_language_selector">
                                <t t-set="_item_class" t-valuef="nav-item dropdown ms-lg-1 facodi-language-selector"/>
                                <t t-set="_btn_class" t-valuef="nav-link d-flex align-items-center gap-1"/>
                                <t t-set="_txt_class" t-valuef="small"/>
                                <t t-set="_flag_class" t-valuef="me-1"/>
                                <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end facodi-dropdown-menu"/>
                            </t>
                            <t t-call="portal.placeholder_user_sign_in">
                                <t t-set="_item_class" t-valuef="nav-item ms-lg-2"/>
                                <t t-set="_link_class" t-valuef="btn facodi-button facodi-button-primary"/>
                            </t>
                            <t t-call="portal.user_dropdown">
                                <t t-set="_user_name" t-value="true"/>
                                <t t-set="_item_class" t-valuef="nav-item dropdown ms-lg-2"/>
                                <t t-set="_link_class" t-valuef="btn facodi-button facodi-button-primary border-0"/>
                                <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end"/>
                            </t>
                        </t>
                    </div>
                </t>
                <t t-call="website.template_header_mobile"/>
            </header>
        </xpath>
    </template>

    <!--
        Odoo's standard submenu turns a parent with children into a dropdown
        trigger whose href is "#". FACODI keeps the standard recursion and
        Bootstrap mechanics, but splits navigation from disclosure whenever
        the parent itself has a real destination.
    -->
    <template id="submenu_split_navigation"
              inherit_id="website.submenu"
              name="FACODI Split Submenu Navigation">
        <xpath expr="//a[@t-if='not is_accordion_nav']" position="replace">
            <t t-if="submenu._facodi_landing_url()">
                <div class="facodi-split-menu">
                    <a t-att-href="submenu._facodi_landing_url()"
                       t-attf-class="#{link_class or ''} facodi-split-menu__link #{submenu._is_active() and 'active'}"
                       role="menuitem"
                       t-ignore="true"
                       t-att-target="'_blank' if submenu.new_window else None">
                        <span t-field="submenu.name"/>
                    </a>
                    <button type="button"
                            t-attf-class="dropdown-toggle #{link_class or ''} facodi-split-menu__toggle #{dropdown_toggler_classes}"
                            data-bs-toggle="dropdown"
                            t-att-data-bs-display="'static' if submenu.is_mega_menu else None"
                            data-bs-auto-close="outside"
                            aria-label="Open submenu">
                        <span class="visually-hidden">Open submenu</span>
                    </button>
                </div>
            </t>
            <a t-else=""
               href="#"
               t-attf-class="dropdown-toggle #{link_class or ''} #{submenu.is_mega_menu and 'o_mega_menu_toggle'} #{submenu._is_active() and 'active'} #{dropdown_toggler_classes}"
               data-bs-toggle="dropdown"
               t-att-data-bs-display="'static' if submenu.is_mega_menu else None"
               data-bs-auto-close="outside"
               role="menuitem">
                <span t-field="submenu.name"/>
            </a>
        </xpath>
        <xpath expr="//div[@t-elif='is_accordion_nav']/a[@href='#']" position="replace">
            <div t-if="submenu._facodi_landing_url()"
                 class="facodi-split-menu facodi-split-menu--mobile">
                <a t-att-href="submenu._facodi_landing_url()"
                   t-attf-class="#{link_class or ''} facodi-split-menu__link"
                   role="menuitem"
                   t-ignore="true"
                   t-att-target="'_blank' if submenu.new_window else None">
                    <span t-field="submenu.name"/>
                </a>
                <button type="button"
                        t-attf-class="#{link_class or ''} accordion-button collapsed facodi-split-menu__toggle"
                        data-bs-toggle="collapse"
                        t-attf-data-bs-target=".o_accordion_target_#{submenu.id}"
                        aria-expanded="false"
                        t-attf-aria-controls="o_accordion_target_#{submenu.id}"
                        aria-label="Open submenu">
                    <span class="visually-hidden">Open submenu</span>
                </button>
            </div>
            <a t-else=""
               href="#"
               t-attf-class="#{link_class or ''} accordion-button collapsed"
               data-bs-toggle="collapse"
               t-attf-data-bs-target=".o_accordion_target_#{submenu.id}"
               aria-expanded="false"
               t-attf-aria-controls="o_accordion_target_#{submenu.id}">
                <span t-field="submenu.name"/>
            </a>
        </xpath>
    </template>
</odoo>
