<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_community" name="FACODI Community and contribution">
        <section class="s_facodi_community facodi-section o_cc o_cc1 facodi-dot-grid-host"
                 data-snippet="s_facodi_community"
                 data-name="Community and contribution">
            <div class="facodi-dot-grid facodi-dot-grid--section"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="container">
                <div class="facodi-community-grid">
                    <article class="facodi-note facodi-community-card" data-facodi-motion="tilt">
                        <p class="facodi-label facodi-label-mint">Collective intelligence</p>
                        <h2>A useful discovery deserves company.</h2>
                        <p>Found a video, course or public resource that made something click? Leave a useful trail for the next learner.</p>
                        <div class="facodi-actions">
                            <a href="/submissions/new?type=resource&amp;source=community_resource_cta&amp;section=community" class="btn facodi-button facodi-button-primary">Suggest a resource</a>
                            <a href="/forum" class="btn facodi-button facodi-button-secondary">Join the forum</a>
                            <a href="/contact?source=community_collaboration_cta&amp;section=community&amp;topic=collaboration" class="facodi-text-link">Collaborate with FACODI</a>
                            <a href="https://www.instagram.com/somosfacodi/" target="_blank" rel="noopener noreferrer" class="facodi-text-link">
                                Follow <span t-translation="off">@somosfacodi</span>
                                <i class="fa fa-instagram ms-1" aria-hidden="true" t-translation="off"/>
                            </a>
                        </div>
                    </article>
                    <article class="facodi-sheet facodi-community-card facodi-community-card-build" data-facodi-motion="tilt" data-facodi-motion-delay="100">
                        <p class="facodi-label facodi-label-sun">Still open</p>
                        <h2>We are still building. You can be part of it.</h2>
                        <p>Translations, corrections, context and better links can turn a public resource into something much easier to learn from.</p>
                        <div class="facodi-actions">
                            <a href="/submissions/new?type=correction&amp;source=translation_correction_cta&amp;section=translation" class="btn facodi-button facodi-button-secondary">Improve a translation</a>
                            <a href="/courses" class="facodi-text-link">Explore courses <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </template>
</odoo>
