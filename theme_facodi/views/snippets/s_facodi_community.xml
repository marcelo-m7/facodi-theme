<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_community" name="FACODI Community and contribution">
        <section class="s_facodi_community facodi-section o_cc o_cc1"
                 data-snippet="s_facodi_community"
                 data-name="Community and contribution">
            <div class="container">
                <div class="facodi-community-grid">
                    <article class="facodi-note facodi-community-card">
                        <p class="facodi-label">Community notebook</p>
                        <h2>A useful discovery deserves company.</h2>
                        <p>Found a video, course or public resource that made something click? Leave a useful trail for the next learner.</p>
                        <div class="facodi-actions">
                            <a href="/submissions/new?type=resource&amp;source=community_resource_cta&amp;section=community" class="btn facodi-button facodi-button-primary">Suggest a resource</a>
                            <a href="/forum" class="btn facodi-button facodi-button-secondary">Join the forum</a>
                            <a href="/contact?source=community_collaboration_cta&amp;section=community&amp;topic=collaboration" class="facodi-text-link">Collaborate with FACODI</a>
                        </div>
                    </article>
                    <article class="facodi-sheet facodi-community-card facodi-community-card-build">
                        <p class="facodi-label">Open campus</p>
                        <h2>Still building. You can improve the trail.</h2>
                        <p>Translations, corrections, context and better links can turn a public resource into something much easier to learn from.</p>
                        <div class="facodi-actions">
                            <a href="/submissions/new?type=correction&amp;source=translation_correction_cta&amp;section=translation" class="btn facodi-button facodi-button-secondary">Improve a translation</a>
                            <a href="/blog" class="facodi-text-link">Read project news <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></a>
                        </div>
                    </article>
                </div>
            </div>
        </section>
    </template>
</odoo>
