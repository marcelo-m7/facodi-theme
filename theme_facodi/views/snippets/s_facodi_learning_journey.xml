                        <i class="fa fa-book" aria-hidden="true" t-translation="off"/>
                    </article>
                    <article class="facodi-stat-card facodi-sun">
                        <div class="facodi-stat-eyebrow">Step 03</div>
                        <div class="facodi-stat-title">Start a course</div>
                        <div class="facodi-stat-copy">Learn with published courses and content at your own pace.</div>
                        <a href="/slides" class="facodi-text-link">Explore courses <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></a>
