<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_learning_journey" name="FACODI Learning Journey">
        <section class="s_facodi_learning_journey facodi-section o_cc o_cc1 facodi-dot-grid-host"
                 data-snippet="s_facodi_learning_journey"
                 data-name="Learning Journey">
            <div class="facodi-dot-grid facodi-dot-grid--section"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="container">
                <div class="facodi-section-heading" data-facodi-motion="rise">
                    <div>
                        <p class="facodi-kicker facodi-kicker-ruled">
                            <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                            Choose your route
                        </p>
                        <h2>Explore learning in the way that makes sense to you.</h2>
                        <p class="facodi-section-copy">Start with a ready-made course, follow a direction or begin from an academic reference.</p>
                    </div>
                </div>
                <div class="facodi-learning-entry-grid facodi-learning-bento">
                    <a href="/courses" class="facodi-card facodi-card--learning facodi-learning-card facodi-learning-card-mint facodi-learning-bento__wide" data-facodi-motion="tilt" data-facodi-motion-delay="0">
                        <p class="facodi-label">Quick start · direct modules</p>
                        <span class="facodi-card-icon facodi-card-icon-mint"><i class="fa fa-book" aria-hidden="true" t-translation="off"/></span>
                        <h3>Courses</h3>
                        <p>Curated collections of public resources that give a topic a useful structure.</p>
                        <div class="facodi-text-link">Explore courses <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                    <a href="/roadmaps" class="facodi-card facodi-card--institutional facodi-learning-card facodi-learning-card-sky" data-facodi-motion="tilt" data-facodi-motion-delay="70">
                        <p class="facodi-label">Connected view · pathways</p>
                        <span class="facodi-card-icon facodi-card-icon-cyan"><i class="fa fa-map" aria-hidden="true" t-translation="off"/></span>
                        <h3>Learning paths</h3>
                        <p>See how topics, courses and study resources connect across a learning direction.</p>
                        <div class="facodi-text-link">Explore learning paths <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                    <a href="/curricular-units" class="facodi-card facodi-card--learning facodi-learning-card facodi-learning-card-sun" data-facodi-motion="tilt" data-facodi-motion-delay="140">
                        <p class="facodi-label">University reference · context</p>
                        <span class="facodi-card-icon facodi-card-icon-sun"><i class="fa fa-university" aria-hidden="true" t-translation="off"/></span>
                        <h3>Curricular units</h3>
                        <p>Start from a reviewed academic reference and discover related open learning.</p>
                        <div class="facodi-text-link">Explore curricular units <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                    <a href="/explore" class="facodi-card facodi-card--resource facodi-learning-card facodi-learning-card-paper facodi-learning-bento__wide" data-facodi-motion="tilt" data-facodi-motion-delay="210">
                        <p class="facodi-label">Study materials · guides</p>
                        <span class="facodi-card-icon facodi-card-icon-sun"><i class="fa fa-folder-open" aria-hidden="true" t-translation="off"/></span>
                        <h3>Resources</h3>
                        <p>Browse public learning materials connected to useful study context.</p>
                        <div class="facodi-text-link">Explore resources <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
