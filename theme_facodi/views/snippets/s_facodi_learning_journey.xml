<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_learning_journey" name="FACODI Learning Journey">
        <section class="s_facodi_learning_journey facodi-section o_cc o_cc1"
                 data-snippet="s_facodi_learning_journey"
                 data-name="Learning Journey">
            <div class="container">
                <div class="facodi-section-heading">
                    <div>
                        <p class="facodi-kicker">
                            <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                            Choose your route
                        </p>
                        <h2>Explore learning in the way that makes sense to you.</h2>
                        <p class="facodi-section-copy">Start with a ready-made course, follow a direction or begin from an academic reference.</p>
                    </div>
                </div>
                <div class="facodi-learning-entry-grid">
                    <a href="/courses" class="facodi-learning-card facodi-learning-card-mint">
                        <p class="facodi-label">Quick start</p>
                        <i class="fa fa-book" aria-hidden="true" t-translation="off"/>
                        <h3>Courses</h3>
                        <p>Curated collections of public resources that give a topic a useful structure.</p>
                        <div class="facodi-text-link">Explore courses <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                    <a href="/roadmaps" class="facodi-learning-card facodi-learning-card-sky">
                        <p class="facodi-label">Follow a direction</p>
                        <i class="fa fa-map" aria-hidden="true" t-translation="off"/>
                        <h3>Roadmaps</h3>
                        <p>See how topics, courses and study resources connect across a learning direction.</p>
                        <div class="facodi-text-link">Explore Roadmaps <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                    <a href="/curricular-units" class="facodi-learning-card facodi-learning-card-sun">
                        <p class="facodi-label">Academic context</p>
                        <i class="fa fa-university" aria-hidden="true" t-translation="off"/>
                        <h3>Curricular units</h3>
                        <p>Start from a reviewed academic reference and discover related open learning.</p>
                        <div class="facodi-text-link">Explore curricular units <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></div>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
