<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_course_showcase" name="FACODI Course Showcase">
        <section class="s_facodi_course_showcase s_dynamic_snippet s_dynamic o_cc o_cc1"
                 data-snippet="s_facodi_course_showcase"
                 data-name="FACODI Course Showcase"
                 t-att-data-filter-id="env.ref('theme_facodi.dynamic_filter_published_courses').id"
                 data-template-key="theme_facodi.dynamic_filter_template_slide_channel_facodi_course_card"
                 data-number-of-records="6"
                 data-extra-classes="g-3"
                 data-column-classes="col-12 col-sm-6 col-lg-4">
            <div class="s_dynamic_snippet_container facodi-dynamic-shell facodi-course-catalogue-paper">
                <div class="container">
                    <div class="facodi-section-heading">
                        <div>
                            <p class="facodi-kicker">Learning catalogue</p>
                            <h2>Published courses</h2>
                        </div>
                        <nav class="facodi-catalogue-tabs" aria-label="Learning catalogue">
                            <a href="/roadmaps">Roadmaps</a>
                            <a href="/unidades-curriculares">Curricular Units</a>
                            <a href="/slides" class="is-active">Courses</a>
                            <a href="/contribuir/recurso">Contribute</a>
                        </nav>
                    </div>

                    <section class="s_dynamic_snippet_content facodi-dynamic-content oe_unremovable oe_unmovable o_not_editable">
                        <div class="css_non_editable_mode_hidden">
                            <div class="missing_option_warning alert alert-info d-none mt-3">
                                Course cards appear here when published courses are available.
                            </div>
                        </div>
                        <div class="dynamic_snippet_template facodi-course-grid"/>
                    </section>

                    <aside class="facodi-sheet facodi-catalogue-next">
                        <div>
                            <p class="facodi-label">Next study</p>
                            <h3>Explore the available courses</h3>
                            <p>Open the catalogue and choose the next topic in your learning journey.</p>
                        </div>
                        <a class="btn facodi-button facodi-button-primary" href="/slides">
                            View catalogue
                            <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                        </a>
                    </aside>
                </div>
            </div>
        </section>
    </template>

    <template id="dynamic_filter_template_slide_channel_facodi_course_card"
              name="FACODI Course Card">
        <t t-foreach="records" t-as="data"
           data-container-classes="facodi-dynamic-shell"
           data-content-classes="facodi-dynamic-content">
            <t t-set="channel" t-value="data['_record']"/>
            <a t-att-href="data.get('call_to_action_url') or '/slides'"
               class="facodi-course-card"
               t-att-aria-label="data.get('name')">
                <div class="facodi-course-art">
                    <img t-if="data.get('image_1920')"
                         t-att-src="data.get('image_1920')"
                         t-att-alt="data.get('name')"
                         loading="eager"/>
                    <t t-else="">
                        <span t-out="(data.get('name') or '')[:2].upper()"/>
                        <i class="fa fa-book" aria-hidden="true" t-translation="off"/>
                    </t>
                </div>
                <div class="facodi-course-content">
                    <div class="facodi-course-description" t-field="channel.description_short"/>
                    <h3 t-out="data.get('name')"/>
                    <div class="facodi-card-bottom">
                        <p class="m-0">
                            <t t-out="data.get('total_slides') or 0"/>
                            lessons
                        </p>
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </div>
                </div>
            </a>
        </t>
    </template>
</odoo>
