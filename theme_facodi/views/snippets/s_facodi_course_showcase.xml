<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_course_showcase" name="FACODI Course Showcase">
        <section class="s_facodi_course_showcase s_dynamic_snippet s_dynamic o_cc o_cc1"
                 data-snippet="s_facodi_course_showcase"
                 data-name="FACODI Course Showcase"
                 t-att-data-filter-id="env.ref('theme_facodi.dynamic_filter_published_courses').id"
                 data-template-key="theme_facodi.dynamic_filter_template_slide_channel_facodi_course_card"
                 data-number-of-records="6"
                 data-extra-classes="g-3"
                 data-column-classes="col-12 col-sm-6 col-lg-4">
            <div class="s_dynamic_snippet_container facodi-dynamic-shell facodi-course-catalogue-paper">
                <div class="container">
                    <div class="facodi-section-heading" data-facodi-motion="rise">
                        <div>
                            <p class="facodi-kicker">Learning catalogue</p>
                            <h2>Start somewhere useful.</h2>
                            <p class="facodi-section-copy">Published FACODI courses connect open resources into practical starting points.</p>
                        </div>
                        <nav class="facodi-catalogue-tabs" aria-label="Learning catalogue">
                            <a href="/roadmaps">Roadmaps</a>
                            <a href="/curricular-units">Curricular Units</a>
                            <a href="/courses" class="is-active">Courses</a>
                            <a href="/submissions/new?type=resource&amp;source=course_showcase_contribute&amp;section=learning-catalogue">Contribute</a>
                        </nav>
                    </div>

                    <section class="s_dynamic_snippet_content facodi-dynamic-content oe_unremovable oe_unmovable o_not_editable" data-facodi-motion="fade" data-facodi-motion-delay="80">
                        <div class="css_non_editable_mode_hidden">
                            <div class="missing_option_warning alert alert-info d-none mt-3">
                                Course cards appear here when published courses are available.
                            </div>
                        </div>
                        <div class="dynamic_snippet_template facodi-course-grid"/>
                    </section>

                    <aside class="facodi-sheet facodi-catalogue-next" data-facodi-motion="rise" data-facodi-motion-delay="140">
                        <div>
                            <p class="facodi-label">Keep exploring</p>
                            <h3>There is more in the catalogue.</h3>
                            <p>Browse every published course and choose the next topic that fits your learning journey.</p>
                        </div>
                        <a class="btn facodi-button facodi-button-primary" href="/courses">
                            View catalogue
                            <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                        </a>
                    </aside>
                </div>
            </div>
        </section>
    </template>

    <template id="dynamic_filter_template_slide_channel_facodi_course_card"
              name="FACODI Course Card">
        <t t-set="facodi_showcase_channels"
           t-value="env['slide.channel'].browse([row['_record'].id for row in records])"/>
        <t t-set="facodi_showcase_visuals"
           t-value="facodi_showcase_channels._facodi_catalog_visuals()"/>
        <t t-foreach="records" t-as="data"
           data-container-classes="facodi-dynamic-shell"
           data-content-classes="facodi-dynamic-content">
            <t t-set="channel" t-value="data['_record']"/>
            <a t-att-href="data.get('call_to_action_url') or '/slides'"
               class="facodi-course-card"
               t-att-aria-label="data.get('name')">
                <t t-set="facodi_visual" t-value="facodi_showcase_visuals.get(channel.id)"/>
                <div class="facodi-course-art">
                    <img t-if="facodi_visual and facodi_visual.get('kind') == 'slide'"
                         t-att-src="'/web/image/slide.slide/%s/image_512' % facodi_visual['slide'].id"
                         t-att-alt="facodi_visual.get('alt') or data.get('name') or 'FACODI course'"
                         loading="eager"
                         decoding="async"/>
                    <img t-elif="facodi_visual and facodi_visual.get('kind') == 'youtube'"
                         t-att-src="facodi_visual.get('url')"
                         t-att-alt="facodi_visual.get('alt') or data.get('name') or 'FACODI course'"
                         loading="eager"
                         decoding="async"
                         referrerpolicy="strict-origin-when-cross-origin"/>
                    <div t-else="" class="facodi-course-fallback" aria-hidden="true">
                        <span class="facodi-course-fallback-brand" t-translation="off">FACODI.</span>
                        <strong t-out="(data.get('name') or '')[:2].upper()"/>
                        <i class="fa fa-play-circle" aria-hidden="true" t-translation="off"/>
                    </div>
                </div>
                <div class="facodi-course-content">
                    <div class="facodi-course-description" t-field="channel.description_short"/>
                    <h3 t-out="data.get('name')"/>
                    <div class="facodi-card-bottom">
                        <p class="m-0">
                            <t t-out="data.get('total_slides') or 0"/>
                            lessons
                        </p>
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </div>
                </div>
            </a>
        </t>
    </template>
</odoo>
