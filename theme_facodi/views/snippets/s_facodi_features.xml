<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_features" name="FACODI Learning principles">
        <section class="s_facodi_features facodi-section facodi-grid-paper o_cc o_cc1 facodi-dot-grid-host"
                 data-snippet="s_facodi_features"
                 data-name="FACODI Learning principles">
            <div class="facodi-dot-grid facodi-dot-grid--section"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="container">
                <div class="facodi-section-heading" data-facodi-motion="rise">
                    <div>
                        <p class="facodi-kicker">Step by step</p>
                        <h2>From a question to the next useful link.</h2>
                        <p class="facodi-section-copy">FACODI is designed for movement: ask, explore, connect and leave a better trail behind.</p>
                    </div>
                </div>
                <div class="facodi-learning-steps facodi-learning-steps-three">
                    <article class="facodi-sheet facodi-learning-step facodi-learning-step-pink" data-facodi-motion="rise" data-facodi-motion-delay="0">
                        <span class="facodi-tape facodi-tape-pink" aria-hidden="true"/>
                        <p class="facodi-step-number">01</p>
                        <p class="facodi-label">Choose a question</p>
                        <h3>Start with curiosity.</h3>
                        <p>Find a real question, doubt or topic. You do not need a perfect plan before you begin.</p>
                        <p class="facodi-step-footnote">Start here · turn curiosity into a route</p>
                    </article>
                    <article class="facodi-sheet facodi-learning-step facodi-learning-step-sun" data-facodi-motion="rise" data-facodi-motion-delay="70">
                        <span class="facodi-tape facodi-tape-sun" aria-hidden="true"/>
                        <p class="facodi-step-number">02</p>
                        <p class="facodi-label">Study at your pace</p>
                        <h3>Use the rhythm that fits.</h3>
                        <p>Combine courses, videos, notes and curricular references without forcing every learner through the same sequence.</p>
                        <p class="facodi-step-footnote">Made from public learning resources</p>
                    </article>
                    <article class="facodi-sheet facodi-learning-step facodi-learning-step-cyan" data-facodi-motion="rise" data-facodi-motion-delay="140">
                        <span class="facodi-tape facodi-tape-cyan" aria-hidden="true"/>
                        <p class="facodi-step-number">03</p>
                        <p class="facodi-label">Follow the next clue</p>
                        <h3>Keep the useful thread.</h3>
                        <p>Discover related references, move between fields and share a better trail with the community.</p>
                        <p class="facodi-step-footnote">Transfer knowledge to new contexts</p>
                    </article>
                </div>
            </div>
        </section>
    </template>
</odoo>
