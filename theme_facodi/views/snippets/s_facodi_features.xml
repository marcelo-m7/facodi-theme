<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_features" name="FACODI Learning principles">
        <section class="s_facodi_features facodi-section facodi-grid-paper o_cc o_cc1"
                 data-snippet="s_facodi_features"
                 data-name="FACODI Learning principles">
            <div class="container">
                <div class="facodi-section-heading" data-facodi-motion="rise">
                    <div>
                        <p class="facodi-kicker">Step by step</p>
                        <h2>From a question to the next useful link.</h2>
                        <p class="facodi-section-copy">FACODI is designed for movement: ask, explore, connect and leave a better trail behind.</p>
                    </div>
                </div>
                <div class="facodi-learning-steps facodi-learning-steps-four">
                    <article class="facodi-sheet facodi-learning-step" data-facodi-motion="rise" data-facodi-motion-delay="0">
                        <p class="facodi-label">01 · Ask</p>
                        <h3>Choose a question</h3>
                        <p>Begin with something you genuinely want to understand.</p>
                    </article>
                    <article class="facodi-postit facodi-learning-step" data-facodi-motion="rise" data-facodi-motion-delay="70">
                        <p class="facodi-label">02 · Explore</p>
                        <h3>Study at your pace</h3>
                        <p>Use courses and resources without pretending every learner follows the same sequence.</p>
                    </article>
                    <article class="facodi-note facodi-learning-step" data-facodi-motion="rise" data-facodi-motion-delay="140">
                        <p class="facodi-label">03 · Connect</p>
                        <h3>Follow the useful thread</h3>
                        <p>Move between topics, courses, Roadmaps and academic context when a connection helps.</p>
                    </article>
                    <article class="facodi-sheet facodi-learning-step facodi-learning-step-contribute" data-facodi-motion="rise" data-facodi-motion-delay="210">
                        <p class="facodi-label">04 · Contribute</p>
                        <h3>Leave the trail clearer</h3>
                        <p>Share a resource, correction or context that may help the next learner.</p>
                    </article>
                </div>
            </div>
        </section>
    </template>
</odoo>
