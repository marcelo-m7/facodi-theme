<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_course_cta" name="FACODI Course catalogue CTA">
        <section class="s_facodi_course_cta facodi-section o_cc o_cc1" data-snippet="s_facodi_course_cta" data-name="FACODI Course catalogue CTA">
            <div class="container">
                <h2>From curiosity to the next click.</h2>
                <p class="facodi-lead">Pick a question. Follow a course or a Roadmap. When a resource changes how you see a subject, keep that thread close.</p>
                <div class="facodi-actions">
                    <a href="/slides" class="btn facodi-button facodi-button-primary">
                        Choose a course
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a href="/roadmaps" class="btn facodi-button facodi-button-secondary">
                        Follow a Roadmap
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a href="/unidades-curriculares" class="btn facodi-button facodi-button-secondary">
                        Check a curricular unit
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a href="/contribuir/recurso" class="btn facodi-button facodi-button-secondary">
                        Share a discovery
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </a>
                </div>
            </div>
        </section>
    </template>
</odoo>
