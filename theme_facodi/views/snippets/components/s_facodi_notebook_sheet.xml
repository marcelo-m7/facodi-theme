<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_notebook_sheet" name="FACODI Notebook Sheet">
        <article class="facodi-notebook-sheet"
                 data-snippet="s_facodi_notebook_sheet"
                 data-name="FACODI Notebook Sheet">
            <div class="facodi-notebook-holes" aria-hidden="true"><span/><span/><span/><span/></div>
            <header>
                <p class="facodi-kicker">Study worksheet</p>
                <h3>Editable learning worksheet</h3>
            </header>
            <ul class="facodi-notebook-list">
                <li><i class="fa fa-square-o" aria-hidden="true" t-translation="off"/><span>Add an activity or study prompt.</span></li>
                <li><i class="fa fa-square-o" aria-hidden="true" t-translation="off"/><span>Add an example, reflection, or reading task.</span></li>
                <li><i class="fa fa-square-o" aria-hidden="true" t-translation="off"/><span>Add a public resource or contribution prompt.</span></li>
            </ul>
            <p class="facodi-notebook-caption">This is static Website Builder content, not a private or persistent learner notebook.</p>
        </article>
    </template>
</odoo>
