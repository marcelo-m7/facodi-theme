<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_progress_meter" name="FACODI Progress Meter">
        <article class="facodi-progress-meter"
                 data-snippet="s_facodi_progress_meter"
                 data-name="FACODI Progress Meter">
            <div class="facodi-progress-meter-heading">
                <div>
                    <p class="facodi-label">Study tracker layout</p>
                    <h3>Editable progress presentation</h3>
                </div>
                <strong>Set value</strong>
            </div>
            <div class="facodi-progress-track" aria-hidden="true">
                <span/>
            </div>
            <div class="facodi-progress-metrics">
                <div><strong>—</strong><span>Milestone label</span></div>
                <div><strong>—</strong><span>Activity label</span></div>
                <div><strong>—</strong><span>Contribution label</span></div>
            </div>
            <p class="facodi-notebook-caption">This is static Website Builder content. Add percentages or counts only when they come from a real published source.</p>
        </article>
    </template>
</odoo>
