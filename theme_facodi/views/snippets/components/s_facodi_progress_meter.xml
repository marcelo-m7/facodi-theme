<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_progress_meter" name="FACODI Progress Meter">
        <article class="facodi-progress-meter"
                 data-snippet="s_facodi_progress_meter"
                 data-name="FACODI Progress Meter">
            <div class="facodi-progress-meter-heading">
                <div>
                    <p class="facodi-label">Learning progress</p>
                    <h3>68% of this study plan completed</h3>
                </div>
                <strong>68%</strong>
            </div>
            <div class="facodi-progress-track" role="progressbar" aria-label="Learning progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="68">
                <span style="width: 68%"/>
            </div>
            <div class="facodi-progress-metrics">
                <div><strong>12</strong><span>study notes</span></div>
                <div><strong>4</strong><span>completed modules</span></div>
                <div><strong>3</strong><span>community contributions</span></div>
            </div>
        </article>
    </template>
</odoo>
