<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_uc_progress_card" name="FACODI Curricular Unit Progress Card">
        <article class="facodi-uc-progress-card"
                 data-snippet="s_facodi_uc_progress_card"
                 data-name="FACODI Curricular Unit Progress Card">
            <span class="facodi-paper-card-stripe facodi-paper-card-stripe-cyan" aria-hidden="true"/>
            <header>
                <span class="facodi-label">Unit code</span>
                <span class="facodi-uc-status">Study status</span>
            </header>
            <h3>Curricular unit title</h3>
            <p>Use this static Website Builder card to introduce a curricular unit or learning milestone without implying tracked progress.</p>
            <div class="facodi-progress-track" aria-hidden="true">
                <span/>
            </div>
            <footer>
                <span>Add real progress only when a trusted source provides it</span>
                <a href="/unidades-curriculares" class="facodi-text-link">Explore curricular units <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/></a>
            </footer>
        </article>
    </template>
</odoo>
