<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_process_timeline" name="FACODI Process Timeline">
        <ol class="facodi-process-timeline" data-snippet="s_facodi_process_timeline" data-name="FACODI Process Timeline">
            <li class="facodi-process-timeline__step">
                <span class="facodi-process-timeline__index">1</span>
                <div><h3>Pick a route</h3><p>Start with a course, Roadmap, curricular unit or one very concrete question.</p></div>
            </li>
            <li class="facodi-process-timeline__step">
                <span class="facodi-process-timeline__index">2</span>
                <div><h3>Open the good tabs</h3><p>Use public resources and follow only the context that helps you move forwards.</p></div>
            </li>
            <li class="facodi-process-timeline__step">
                <span class="facodi-process-timeline__index">3</span>
                <div><h3>Connect the dots</h3><p>Relate useful material to the learning path so it becomes more than one clever link in isolation.</p></div>
            </li>
            <li class="facodi-process-timeline__step">
                <span class="facodi-process-timeline__index">4</span>
                <div><h3>Send something back</h3><p>Found a useful public resource or a gap worth fixing? Put it on the review desk for the community.</p></div>
            </li>
        </ol>
    </template>
</odoo>
