<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_forum_postit" name="FACODI Community Post-it">
        <article class="facodi-forum-postit"
                 data-snippet="s_facodi_forum_postit"
                 data-name="FACODI Community Post-it">
            <span class="facodi-forum-pin" aria-hidden="true"/>
            <div class="facodi-forum-postit-meta">
                <span class="facodi-label">Community note</span>
                <span>Editorial prompt</span>
            </div>
            <h3>Add a discussion prompt, study-group invitation, or shared summary.</h3>
            <p>This is an editable Website Builder card. It does not create a forum, private thread, or persistent discussion record.</p>
            <pre><code># Optional static example or short excerpt</code></pre>
            <footer>
                <span>Website Builder card</span>
                <a href="/contactus" class="facodi-text-link">Contact FACODI</a>
            </footer>
        </article>
    </template>
</odoo>
