<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_student_id_card" name="FACODI Student ID Card">
        <article class="facodi-student-id-card"
                 data-snippet="s_facodi_student_id_card"
                 data-name="FACODI Student ID Card">
            <span class="facodi-student-id-tape" aria-hidden="true"/>
            <header class="facodi-student-id-header">
                <div>
                    <p class="facodi-kicker">Editable learning profile</p>
                    <h3>Learning profile card</h3>
                </div>
                <span class="facodi-label">FACODI // profile</span>
            </header>
            <div class="facodi-student-id-grid">
                <div class="facodi-student-id-avatar" aria-hidden="true">
                    <i class="fa fa-user"/>
                </div>
                <div>
                    <p class="facodi-label">Display name</p>
                    <h4>Add a learner or contributor name</h4>
                    <p>Use this static Website Builder card for an editorial profile, portfolio introduction, mentor note, or study-group description.</p>
                    <div class="facodi-metadata-row">
                        <span>Focus area</span>
                        <span>Learning mode</span>
                        <span>Community role</span>
                    </div>
                </div>
            </div>
            <footer class="facodi-student-id-footer">
                <span>Editable Website content</span>
                <span>No persistent profile data</span>
            </footer>
        </article>
    </template>
</odoo>
