<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_academic_areas" name="FACODI Academic Areas">
        <section class="s_facodi_academic_areas facodi-section o_cc o_cc2 facodi-dot-grid-host"
                 data-snippet="s_facodi_academic_areas"
                 data-name="FACODI Academic Areas">
            <div class="facodi-dot-grid facodi-dot-grid--section"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true"><canvas class="facodi-dot-grid__canvas"></canvas></div>
            <div class="container">
                <div class="facodi-section-heading" data-facodi-motion="rise">
                    <div>
                        <p class="facodi-kicker">
                            <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                            Subject shelf
                        </p>
                        <h2>Move across fields without losing the thread.</h2>
                        <p class="facodi-section-copy">Use the catalogue as a shelf: open a field, find a starting point and keep moving when another topic becomes relevant.</p>
                    </div>
                    <a href="/courses" class="facodi-text-link">
                        Browse all courses
                        <i class="fa fa-arrow-right" aria-hidden="true" t-translation="off"/>
                    </a>
                </div>
                <nav class="facodi-area-grid facodi-area-shelf" aria-label="Learning areas" data-facodi-motion="fade" data-facodi-motion-delay="90">
                    <a href="/courses" class="facodi-area-tab facodi-area-tab-mint">
                        <span class="facodi-label">01</span>
                        <strong>Computing &amp; Technology</strong>
                        <small>Programming · systems · software</small>
                    </a>
                    <a href="/curricular-units" class="facodi-area-tab facodi-area-tab-sky">
                        <span class="facodi-label">02</span>
                        <strong>Mathematics &amp; Data</strong>
                        <small>Calculus · statistics · data</small>
                    </a>
                    <a href="/courses" class="facodi-area-tab facodi-area-tab-pink">
                        <span class="facodi-label">03</span>
                        <strong>Design &amp; Visual Culture</strong>
                        <small>Typography · communication · art</small>
                    </a>
                    <a href="/courses" class="facodi-area-tab facodi-area-tab-sun">
                        <span class="facodi-label">04</span>
                        <strong>Business &amp; Organisations</strong>
                        <small>ERP · workflows · management</small>
                    </a>
                    <a href="/explore/content" class="facodi-area-tab facodi-area-tab-paper">
                        <span class="facodi-label">05</span>
                        <strong>Community learning</strong>
                        <small>Open resources beyond a single discipline</small>
                    </a>
                </nav>
            </div>
        </section>
    </template>
</odoo>
