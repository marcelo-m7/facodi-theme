<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_hero" name="FACODI Hero">
        <section class="s_facodi_hero facodi-hero facodi-grid-paper o_cc o_cc1"
                 data-snippet="s_facodi_hero"
                 data-name="FACODI Hero">
            <div class="facodi-dot-grid"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="facodi-hero-copy">
                <p class="facodi-kicker facodi-campus-kicker">
                    <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                    FACODI · An open digital campus
                </p>
                <h1 class="facodi-highlight-cyan">Knowledge is everywhere. Find your next step.</h1>
                <p class="facodi-hero-subtitle">Open learning becomes easier to navigate when useful resources connect.</p>
                <p class="facodi-lead">
                    Explore courses, Roadmaps and curricular units built from public learning resources, reviewed context and community contribution.
                </p>
                <div class="facodi-actions">
                    <a class="btn facodi-button facodi-button-primary" href="/courses">
                        Explore courses
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a class="btn facodi-button facodi-button-secondary" href="/sobre">See how FACODI works</a>
                </div>
                <p class="facodi-hero-open-note">
                    <i class="fa fa-check-circle" aria-hidden="true" t-translation="off"/>
                    Open resources · no paywall · community-curated learning
                </p>
            </div>
            <div class="facodi-hero-study-board" aria-label="FACODI learning map">
                <div class="facodi-dither-veil"
                     data-facodi-dither-veil="1"
                     data-src="/theme_facodi/static/src/img/banner.png"
                     data-pixel-size="5"
                     data-reveal-radius="175"
                     data-linger="1050"
                     data-ink-color="#142846"
                     data-paper-color="#F9FAFB"
                     data-rim-color="#37BED2"
                     aria-hidden="true">
                    <canvas class="facodi-dither-veil__canvas"/>
                </div>
                <article class="facodi-sheet facodi-study-sheet">
                    <div class="facodi-study-sheet-topline">
                        <p class="facodi-tab">Field notebook</p>
                        <span class="facodi-status-chip">Open</span>
                    </div>
                    <p class="facodi-label">Study question</p>
                    <h2>What do you want to understand next?</h2>
                    <div class="facodi-study-route" aria-hidden="true">
                        <span>01</span><i/><span>02</span><i/><span>03</span>
                    </div>
                </article>
                <article class="facodi-note facodi-study-note">
                    <p class="facodi-label">Curricular unit</p>
                    <p class="facodi-study-note-copy">Start from reviewed academic context.</p>
                </article>
                <article class="facodi-postit facodi-study-note facodi-study-note-secondary">
                    <p class="facodi-label">Course</p>
                    <p class="facodi-study-note-copy">Keep following the useful thread.</p>
                </article>
            </div>
        </section>
    </template>
</odoo>
