<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_hero" name="FACODI Hero">
        <section class="s_facodi_hero facodi-hero facodi-grid-paper o_cc o_cc1"
                 data-snippet="s_facodi_hero"
                 data-name="FACODI Hero">
            <div class="facodi-dot-grid"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="facodi-hero-copy">
                <p class="facodi-kicker facodi-campus-kicker">
                    <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                    FACODI · An open digital campus
                </p>
                <h1><span>Knowledge is everywhere.</span> <span class="facodi-marker facodi-marker-cyan">Find your next step.</span></h1>
                <p class="facodi-hero-subtitle">Open learning becomes easier to navigate when useful resources connect.</p>
                <p class="facodi-lead">
                    Explore courses, learning paths and curricular units built from public learning resources, reviewed context and community contributions.
                </p>
                <form action="/courses" method="get" class="facodi-hero-search-box d-flex align-items-stretch gap-2 mb-3">
                    <div class="facodi-hero-search-inner d-flex align-items-center flex-grow-1 px-3">
                        <i class="fa fa-search text-muted me-2" aria-hidden="true" t-translation="off"/>
                        <input type="search" name="search" class="facodi-hero-search-input flex-grow-1" placeholder="What do you want to learn today? (e.g. Algorithms, Calculus, Odoo...)" aria-label="Search courses"/>
                    </div>
                    <button type="submit" class="btn facodi-button facodi-button-primary facodi-hero-search-btn">
                        <span>Search</span>
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </button>
                </form>
                <div class="facodi-actions">
                    <a class="btn facodi-button facodi-button-primary" href="/courses">
                        Explore courses
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a class="btn facodi-button facodi-button-secondary" href="/about">See how FACODI works</a>
                </div>
                <p class="facodi-hero-open-note">
                    <i class="fa fa-check-circle" aria-hidden="true" t-translation="off"/>
                    Open resources · no paywall · community-curated learning
                </p>
            </div>
            <div class="facodi-hero-study-board" aria-label="FACODI learning map">
                <article class="facodi-sheet facodi-study-sheet facodi-caderno-card">
                    <div class="facodi-caderno-tape" aria-hidden="true"/>
                    <div class="facodi-study-sheet-topline d-flex align-items-center justify-content-between mb-2">
                        <p class="facodi-tab">Field notebook</p>
                        <span class="facodi-badge facodi-badge--mint facodi-badge--pill">Real time</span>
                    </div>
                    <div class="facodi-caderno-block facodi-caderno-block--yellow mb-2">
                        <span class="facodi-caderno-kicker">FEATURED TODAY:</span>
                        <h3 class="facodi-caderno-title">How the Internet really works</h3>
                        <p class="facodi-caderno-subtitle">Learning path: Networks &amp; Open Systems</p>
                    </div>
                    <div class="facodi-caderno-block facodi-caderno-block--cyan mb-2">
                        <span class="facodi-caderno-kicker">UNIT IN REVIEW:</span>
                        <h3 class="facodi-caderno-title">Computational Thinking</h3>
                        <p class="facodi-caderno-subtitle">12 resources · 4 open readings</p>
                    </div>
                    <div class="facodi-study-route mb-2" aria-hidden="true">
                        <span>01</span><i/><span>02</span><i/><span>03</span>
                    </div>
                    <div class="facodi-caderno-footer d-flex align-items-center justify-content-between pt-2 border-top">
                        <em class="facodi-caderno-quote">"learning in public"</em>
                        <span class="facodi-badge facodi-badge-year" t-translation="off">FACODI 2026</span>
                    </div>
                </article>
                <article class="facodi-note facodi-study-note">
                    <p class="facodi-label">Curricular unit</p>
                    <p class="facodi-study-note-copy">Start from reviewed academic context.</p><p class="facodi-study-note-meta">Validated against public university references</p>
                </article>
                <article class="facodi-postit facodi-study-note facodi-study-note-secondary">
                    <p class="facodi-label">Course</p>
                    <p class="facodi-study-note-copy">Keep following the useful thread.</p>
                </article>
            </div>
        </section>
    </template>
</odoo>
