<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_hero" name="FACODI Hero">
        <section class="s_facodi_hero facodi-hero facodi-grid-paper o_cc o_cc1"
                 data-snippet="s_facodi_hero"
                 data-name="FACODI Hero">
            <div class="facodi-hero-copy">
                <p class="facodi-kicker">
                    <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                    FACODI · An open digital campus
                </p>
                <h1 class="facodi-highlight">Learn in public.</h1>
                <p class="facodi-hero-subtitle">Open higher education, one useful next step at a time.</p>
                <p class="facodi-lead">
                    Courses, Roadmaps and curricular units connect public learning resources so you can start with a question and keep following the thread.
                </p>
                <div class="facodi-actions">
                    <a class="btn facodi-button facodi-button-primary" href="/slides">
                        Explore free courses
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a class="btn facodi-button facodi-button-secondary" href="/contactus">How FACODI works</a>
                </div>
            </div>
            <div class="facodi-hero-study-board" aria-label="FACODI learning map">
                <article class="facodi-sheet facodi-study-sheet">
                    <p class="facodi-tab">Roadmap</p>
                    <p class="facodi-label">Question 01</p>
                    <h2>Start with what you want to understand.</h2>
                    <div class="facodi-study-route" aria-hidden="true">
                        <span>01</span><i/><span>02</span><i/><span>03</span>
                    </div>
                </article>
                <article class="facodi-note facodi-study-note">
                    <p class="facodi-label">Curricular unit</p>
                    <p class="facodi-study-note-copy">Find verified academic context.</p>
                </article>
                <article class="facodi-postit facodi-study-note facodi-study-note-secondary">
                    <p class="facodi-label">Course</p>
                    <p class="facodi-study-note-copy">Keep following the useful thread.</p>
                </article>
            </div>
        </section>
    </template>
</odoo>
