<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="s_facodi_hero" name="FACODI Hero">
        <section class="s_facodi_hero facodi-hero facodi-grid-paper o_cc o_cc1"
                 data-snippet="s_facodi_hero"
                 data-name="FACODI Hero">
            <div class="facodi-dot-grid"
                 data-facodi-dot-grid="1"
                 data-dot-size="3"
                 data-gap="24"
                 data-proximity="130"
                 data-shock-radius="180"
                 data-shock-strength="4.5"
                 data-base-color="#3979C8"
                 data-active-color="#37BED2"
                 aria-hidden="true">
                <canvas class="facodi-dot-grid__canvas"/>
            </div>
            <div class="facodi-hero-copy">
                <p class="facodi-kicker facodi-campus-kicker">
                    <i class="fa fa-circle" aria-hidden="true" t-translation="off"/>
                    FACODI · An open digital campus
                </p>
                <h1><span>Knowledge is everywhere.</span> <span class="facodi-marker facodi-marker-cyan">Find your next step.</span></h1>
                <p class="facodi-hero-subtitle">Open learning becomes easier to navigate when useful resources connect.</p>
                <p class="facodi-lead">
                    Explore courses, learning paths and curricular units built from public learning resources, reviewed context and community contributions.
                </p>
                <form action="/courses" method="get" class="facodi-hero-search-box d-flex align-items-stretch gap-2 mb-3">
                    <div class="facodi-hero-search-inner d-flex align-items-center flex-grow-1 px-3">
                        <i class="fa fa-search text-muted me-2" aria-hidden="true" t-translation="off"/>
                        <input type="search" name="search" class="facodi-hero-search-input flex-grow-1" placeholder="What do you want to learn today? (e.g. Algorithms, Calculus, Odoo...)" aria-label="Search courses"/>
                    </div>
                    <button type="submit" class="btn facodi-button facodi-button-primary facodi-hero-search-btn">
                        <span>Search</span>
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </button>
                </form>
                <div class="facodi-actions">
                    <a class="btn facodi-button facodi-button-primary" href="/courses">
                        Explore courses
                        <i class="fa fa-arrow-right ms-1" aria-hidden="true" t-translation="off"/>
                    </a>
                    <a class="btn facodi-button facodi-button-secondary" href="/about">See how FACODI works</a>
                </div>
                <p class="facodi-hero-open-note">
                    <i class="fa fa-check-circle" aria-hidden="true" t-translation="off"/>
                    Open resources · no paywall · community-curated learning
                </p>
            </div>

            <div class="facodi-hero-study-board facodi-knowledge-map" aria-label="FACODI learning map">
                <article class="facodi-sheet facodi-knowledge-map__sheet">
                    <p class="facodi-tab">Learning map</p>
                    <div class="facodi-knowledge-map__canvas" aria-hidden="true">
                        <span class="facodi-knowledge-node facodi-knowledge-node--unit">
                            <i class="fa fa-university" aria-hidden="true" t-translation="off"/>
                            <strong>Curricular unit</strong>
                        </span>
                        <span class="facodi-knowledge-line facodi-knowledge-line--one"/>
                        <span class="facodi-knowledge-node facodi-knowledge-node--path">
                            <i class="fa fa-map" aria-hidden="true" t-translation="off"/>
                            <strong>Learning paths</strong>
                        </span>
                        <span class="facodi-knowledge-line facodi-knowledge-line--two"/>
                        <span class="facodi-knowledge-node facodi-knowledge-node--course">
                            <i class="fa fa-book" aria-hidden="true" t-translation="off"/>
                            <strong>Courses</strong>
                        </span>
                        <span class="facodi-knowledge-line facodi-knowledge-line--three"/>
                        <span class="facodi-knowledge-node facodi-knowledge-node--resource">
                            <i class="fa fa-play-circle" aria-hidden="true" t-translation="off"/>
                            <strong>Open resources</strong>
                        </span>
                    </div>
                    <p class="facodi-study-note-meta">Reviewed context helps connect one useful resource to the next learning step.</p>
                </article>
            </div>
        </section>
    </template>
</odoo>
