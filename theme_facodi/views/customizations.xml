<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_layout" inherit_id="website.layout" name="FACODI Website Layout">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="facodi-site" separator=" "/>
        </xpath>
        <xpath expr="//head" position="inside">
            <meta name="theme-color" content="#142846"/>
        </xpath>
        <xpath expr="//link[@rel='canonical']" position="attributes">
            <attribute name="t-att-href">request.httprequest.url_root.rstrip('/') + ((request.httprequest.path[:-7].rstrip('/') or '/') if request.httprequest.path.rstrip('/').endswith('/facodi') else (request.httprequest.path.rstrip('/') or '/'))</attribute>
        </xpath>
    </template>

    <template id="facodi_footer" inherit_id="website.layout" name="FACODI Footer">
        <!-- Odoo renders its copyright/brand-promotion strip outside #footer.
             FACODI already owns copyright/attribution in the custom footer, so
             suppress the duplicate Odoo strip using the same flag as Odoo's
             native "Footer No Copyright" option. -->
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="before">
            <t t-set="no_copyright" t-value="True"/>
        </xpath>
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="facodi-footer facodi-footer-campus" data-name="FACODI Footer" t-if="not no_footer">
                <div class="container-fluid facodi-footer-inner">
                    <div class="facodi-footer-note">
                        <a href="/" class="facodi-wordmark" t-translation="off">FACODI<span>.</span></a>
                        <p>Digital Community College. Open, collaborative and accessible higher education.</p>
                    </div>

                    <nav class="facodi-footer-links" aria-label="Footer navigation">
                        <t t-foreach="website.menu_id.child_id" t-as="footer_menu">
                            <div t-if="footer_menu.is_visible" class="facodi-footer-group">
                                <a t-if="not footer_menu.child_id"
                                   t-att-href="footer_menu._clean_url()">
                                    <span t-field="footer_menu.name"/>
                                </a>
                                <span t-else="" class="facodi-footer-heading">
                                    <span t-field="footer_menu.name"/>
                                </span>
                                <ul t-if="footer_menu.child_id">
                                    <t t-foreach="footer_menu.child_id" t-as="footer_item">
                                        <li t-if="footer_item.is_visible">
                                            <a t-att-href="footer_item._clean_url()">
                                                <span t-field="footer_item.name"/>
                                            </a>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </t>
                        <div class="facodi-footer-group facodi-footer-legal">
                            <span class="facodi-footer-heading">Legal</span>
                            <ul>
                                <li><a href="/privacy-policy">Privacy Policy</a></li>
                                <li><a href="/cookie-policy">Cookie Policy</a></li>
                                <li><a href="/terms-and-conditions">Terms and Conditions</a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <span class="facodi-footer-heading">Account</span>
                            <ul>
                                <li><a href="/my">My account</a></li>
                            </ul>
                        </div>
                        <t t-call="portal.language_selector">
                            <t t-set="_div_classes" t-valuef="facodi-footer-group facodi-footer-language facodi-footer-language-selector"/>
                            <t t-set="_btn_class" t-valuef="btn btn-sm facodi-footer-language-button"/>
                            <t t-set="_dropdown_menu_class" t-valuef="facodi-footer-language-menu"/>
                        </t>
                    </nav>

                    <div class="facodi-footer-meta">
                        <div>Open source for learning in public.</div>
                        <div t-translation="off"><span t-esc="datetime.datetime.now().year"/> FACODI</div>
                        <div>
                            Created by
                            <a href="https://github.com/marcelo-m7" target="_blank" rel="noopener noreferrer" t-translation="off">Marcelo Santos</a>
                            <span aria-hidden="true"> · </span>
                            <span t-translation="off">Monynha Softwares</span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
