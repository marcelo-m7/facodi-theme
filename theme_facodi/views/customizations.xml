                    <div class="facodi-footer-note">
                        <a href="/" class="facodi-wordmark" t-translation="off">FACODI<span>.</span></a>
                        <p>Open learning resources, curricular context and community contributions — organised to help people study, discover and share knowledge.</p>
                        <div class="facodi-footer-badge mt-2 d-flex align-items-center gap-1">
                            <i class="fa fa-check-circle" style="color: #107C41;" aria-hidden="true" t-translation="off"/>
                            <span class="small">Open Educational Resources (REA/OER)</span>
                        </div>
                    </div>

                    <nav class="facodi-footer-links" aria-label="Footer navigation">
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/courses"><t t-esc="({'pt_PT': &quot;Aprender&quot;, 'fr_FR': &quot;Apprendre&quot;, 'es_ES': &quot;Aprender&quot;}).get(request.lang.code, &quot;Learn&quot;)"/></a>
                            <ul>
                                <li><a href="/courses"><t t-esc="({'pt_PT': &quot;Cursos&quot;, 'fr_FR': &quot;Cours&quot;, 'es_ES': &quot;Cursos&quot;}).get(request.lang.code, &quot;Courses&quot;)"/></a></li>
                                <li><a href="/roadmaps"><t t-esc="({'pt_PT': &quot;Percursos de aprendizagem&quot;, 'fr_FR': &quot;Parcours d’apprentissage&quot;, 'es_ES': &quot;Itinerarios de aprendizaje&quot;}).get(request.lang.code, &quot;Learning paths&quot;)"/></a></li>
                                <li><a href="/curricular-units"><t t-esc="({'pt_PT': &quot;Unidades curriculares&quot;, 'fr_FR': &quot;Unités d’enseignement&quot;, 'es_ES': &quot;Unidades curriculares&quot;}).get(request.lang.code, &quot;Curricular units&quot;)"/></a></li>
                                <li><a href="/explore/content"><t t-esc="({'pt_PT': &quot;Recursos educativos&quot;, 'fr_FR': &quot;Ressources pédagogiques&quot;, 'es_ES': &quot;Recursos educativos&quot;}).get(request.lang.code, &quot;Learning resources&quot;)"/></a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/forum"><t t-esc="({'pt_PT': &quot;Comunidade&quot;, 'fr_FR': &quot;Communauté&quot;, 'es_ES': &quot;Comunidad&quot;}).get(request.lang.code, &quot;Community&quot;)"/></a>
