                                <li><a href="/content-rights"><t t-esc="({'pt_PT': &quot;Conteúdos e direitos de autor&quot;, 'fr_FR': &quot;Contenus et droits d’auteur&quot;, 'es_ES': &quot;Contenidos y derechos de autor&quot;}).get(request.lang.code, &quot;Content &amp; copyright&quot;)"/></a></li>
                                <li><a href="/cookie-policy"><t t-esc="({'pt_PT': &quot;Política de cookies&quot;, 'fr_FR': &quot;Politique des cookies&quot;, 'es_ES': &quot;Política de cookies&quot;}).get(request.lang.code, &quot;Cookie policy&quot;)"/></a></li>
                                <li><a href="/accessibility"><t t-esc="({'pt_PT': &quot;Acessibilidade&quot;, 'fr_FR': &quot;Accessibilité&quot;, 'es_ES': &quot;Accesibilidad&quot;}).get(request.lang.code, &quot;Accessibility&quot;)"/></a></li>
