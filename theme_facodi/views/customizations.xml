                                <li><a href="/blog"><t t-esc="({'pt_PT': &quot;Notícias&quot;, 'fr_FR': &quot;Actualités&quot;, 'es_ES': &quot;Noticias&quot;}).get(request.lang.code, &quot;News&quot;)"/></a></li>
                                <li><a href="/submissions/new?type=resource&amp;source=footer"><t t-esc="({'pt_PT': &quot;Contribuir&quot;, 'fr_FR': &quot;Contribuer&quot;, 'es_ES': &quot;Contribuir&quot;}).get(request.lang.code, &quot;Contribute&quot;)"/></a></li>
                                <li><a href="/contact"><t t-esc="({'pt_PT': &quot;Contacto&quot;, 'fr_FR': &quot;Contact&quot;, 'es_ES': &quot;Contacto&quot;}).get(request.lang.code, &quot;Contact&quot;)"/></a></li>
                                <li><a href="/my/home"><t t-esc="({'pt_PT': &quot;A minha conta&quot;, 'fr_FR': &quot;Mon compte&quot;, 'es_ES': &quot;Mi cuenta&quot;}).get(request.lang.code, &quot;My account&quot;)"/></a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/about"><t t-esc="({'pt_PT': &quot;FACODI&quot;, 'fr_FR': &quot;FACODI&quot;, 'es_ES': &quot;FACODI&quot;}).get(request.lang.code, &quot;FACODI&quot;)"/></a>
                            <ul>
                                <li><a href="/about"><t t-esc="({'pt_PT': &quot;Sobre o projeto&quot;, 'fr_FR': &quot;À propos du projet&quot;, 'es_ES': &quot;Sobre el proyecto&quot;}).get(request.lang.code, &quot;About the project&quot;)"/></a></li>
