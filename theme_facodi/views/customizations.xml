                                <li><a href="/partnerships"><t t-esc="({'pt_PT': &quot;Parcerias&quot;, 'fr_FR': &quot;Partenariats&quot;, 'es_ES': &quot;Colaboraciones&quot;}).get(request.lang.code, &quot;Partnerships&quot;)"/></a></li>
                                <li><a href="/about-ualg"><t t-esc="({'pt_PT': &quot;Universidade do Algarve&quot;, 'fr_FR': &quot;Université de l’Algarve&quot;, 'es_ES': &quot;Universidad del Algarve&quot;}).get(request.lang.code, &quot;University of Algarve&quot;)"/></a></li>
