<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="website_layout" inherit_id="website.layout" name="FACODI Website Layout">
        <xpath expr="//div[@id='wrapwrap']" position="attributes">
            <attribute name="t-attf-class" add="facodi-site" separator=" "/>
        </xpath>
        <xpath expr="//head" position="inside">
            <meta name="theme-color" content="#142846"/>
        </xpath>
        <xpath expr="//link[@rel='canonical']" position="attributes">
            <attribute name="t-att-href">request.httprequest.url_root.rstrip('/') + ((request.httprequest.path[:-7].rstrip('/') or '/') if request.httprequest.path.rstrip('/').endswith('/facodi') else (request.httprequest.path.rstrip('/') or '/'))</attribute>
        </xpath>
    </template>

    <!-- Keep copyright suppression theme-owned so Odoo copies it only to the
         Website that applies FACODI. The global website.footer_no_copyright
         customization remains untouched for other Websites/themes. -->
    <template id="facodi_footer_no_copyright"
              inherit_id="website.layout"
              name="FACODI Footer No Copyright">
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="before">
            <t t-set="no_copyright" t-value="True"/>
        </xpath>
    </template>

    <template id="facodi_footer" inherit_id="website.layout" name="FACODI Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <div id="footer" class="facodi-footer facodi-footer-campus" data-name="FACODI Footer" t-if="not no_footer">
                <div class="container-fluid facodi-footer-inner">
                    <div class="facodi-footer-note">
                        <a href="/" class="facodi-wordmark" t-translation="off">FACODI<span>.</span></a>
                        <p>Open learning resources, curricular context and community contributions — organised to help people study, discover and share knowledge.</p>
                        <div class="facodi-footer-badge mt-2 d-flex align-items-center gap-1">
                            <i class="fa fa-check-circle" style="color: #107C41;" aria-hidden="true" t-translation="off"/>
                            <span class="small">Open Educational Resources (REA/OER)</span>
                        </div>
                    </div>

                    <nav class="facodi-footer-links" aria-label="Footer navigation">
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/courses">Learn</a>
                            <ul>
                                <li><a href="/courses">Courses</a></li>
                                <li><a href="/roadmaps">Learning paths</a></li>
                                <li><a href="/curricular-units">Curricular units</a></li>
                                <li><a href="/explore/content">Learning resources</a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/forum">Community</a>
                            <ul>
                                <li><a href="/forum">Discussions</a></li>
                                <li><a href="/blog">News</a></li>
                                <li><a href="/submissions/new?type=resource&amp;source=footer">Contribute</a></li>
                                <li><a href="/contact">Contact</a></li>
                                <li><a href="/my/home">My account</a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/about">FACODI</a>
                            <ul>
                                <li><a href="/about">About the project</a></li>
                                <li><a href="/academic-model">Academic model</a></li>
                                <li><a href="/infrastructure">Technical infrastructure</a></li>
                                <li><a href="/partnerships">Partnerships</a></li>
                                <li><a href="/about-ualg">University of Algarve</a></li>
                                <li><a href="/about-marcelo">Project author</a></li>
                            </ul>
                        </div>
                        <div class="facodi-footer-group">
                            <a class="facodi-footer-heading facodi-footer-heading-link" href="/privacy-policy">Legal &amp; accessibility</a>
                            <ul>
                                <li><a href="/privacy-policy">Privacy policy</a></li>
                                <li><a href="/terms-of-use">Terms of use</a></li>
                                <li><a href="/legal-notice">Legal notice</a></li>
                                <li><a href="/content-rights">Content &amp; copyright</a></li>
                                <li><a href="/cookie-policy">Cookie policy</a></li>
                                <li><a href="/accessibility">Accessibility</a></li>
                            </ul>
                        </div>
                    </nav>

                    <div class="facodi-footer-meta">
                        <div>Open source for learning in public.</div>
                        <div>
                            <a href="https://www.odoo.com/r/aff-marcelo-m7"
                               target="_blank"
                               rel="sponsored noopener noreferrer"
                               class="facodi-text-link">Built with Odoo</a>
                            <span class="small"> · affiliate link</span>
                        </div>
                        <div>
                            <a href="https://www.instagram.com/somosfacodi/"
                               target="_blank"
                               rel="noopener noreferrer"
                               class="facodi-text-link"
                               aria-label="FACODI on Instagram">
                                <i class="fa fa-instagram me-1" aria-hidden="true" t-translation="off"/>
                                <span t-translation="off">@somosfacodi</span>
                            </a>
                        </div>
                        <div t-translation="off"><span t-esc="datetime.datetime.now().year"/> FACODI</div>
                        <div>
                            Created by
                            <a href="https://github.com/marcelo-m7" target="_blank" rel="noopener noreferrer" t-translation="off">Marcelo Santos</a>
                            <span aria-hidden="true"> · </span>
                            <span t-translation="off">Monynha Softwares</span>
                        </div>
                        <div class="mt-2 d-flex align-items-center justify-content-lg-end gap-2">
                            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="facodi-badge facodi-badge--pill text-decoration-none" style="background: var(--facodi-paper-warm); color: #142846;" t-translation="off">
                                <span>CC BY-SA 4.0</span>
                                <i class="fa fa-unlock-alt ms-1" aria-hidden="true"/>
                            </a>
                            <span class="facodi-build-tag text-muted" t-translation="off">BUILD: 2026.02-REL</span>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>
