<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_user_profile_content"
              inherit_id="website_profile.user_profile_content"
              name="FACODI Community Profile">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' container ')][1]"
               position="attributes">
            <attribute name="class" add="facodi-profile-shell" separator=" "/>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' row ')][1]"
               position="before">
            <section class="facodi-profile-hero">
                <div class="facodi-profile-identity">
                    <img class="facodi-profile-avatar"
                         t-att-src="website.image_url(user, 'avatar_256')"
                         t-att-alt="user.name or ''"/>
                    <div class="facodi-profile-heading">
                        <span class="facodi-profile-eyebrow">FACODI · Community</span>
                        <h1 t-out="user.name"/>
                        <p class="facodi-profile-rank" t-if="user.rank_id">
                            <i class="fa fa-star" aria-hidden="true"/>
                            <span t-out="user.rank_id.name"/>
                        </p>
                        <p class="facodi-profile-intro">Learning profile and participation in the FACODI community.</p>
                    </div>
                </div>
                <div class="facodi-profile-stats" aria-label="Profile summary">
                    <div class="facodi-profile-stat">
                        <strong t-out="user.karma"/>
                        <span>XP</span>
                    </div>
                    <div class="facodi-profile-stat">
                        <strong t-out="len(user.badge_ids.filtered(lambda b: b.badge_id.website_published))"/>
                        <span>Badges</span>
                    </div>
                    <div class="facodi-profile-stat">
                        <strong><i class="fa fa-calendar-check-o" aria-hidden="true"/></strong>
                        <span>Member since <span t-out="user.create_date" t-options='{"widget": "date", "format": "MMM yyyy"}' t-if="user.create_date"/><span t-else="">—</span></span>
                    </div>
                </div>
            </section>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_wprofile_sidebar ')]"
               position="attributes">
            <attribute name="class" add="facodi-profile-card" separator=" "/>
        </xpath>
        <xpath expr="//ul[@id='profile_extra_info_tablist']"
               position="attributes">
            <attribute name="class" add="facodi-profile-tabs" separator=" "/>
        </xpath>
        <xpath expr="//div[@id='profile_extra_info_tabcontent']"
               position="attributes">
            <attribute name="class" add="facodi-profile-content" separator=" "/>
        </xpath>
    </template>
</odoo>
