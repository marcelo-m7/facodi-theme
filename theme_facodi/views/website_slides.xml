<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="facodi_courses_home"
              inherit_id="website_slides.courses_home"
              name="FACODI Courses Catalogue">
        <xpath expr="//div[@id='wrap']/div[contains(concat(' ', normalize-space(@class), ' '), ' container ')][1]"
               position="attributes">
            <attribute name="class" add="facodi-slides-catalog" separator=" "/>
        </xpath>
    </template>

    <template id="facodi_courses_search_results"
              inherit_id="website_slides.courses_search_results"
              name="FACODI Course Results">
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_home_main ')]/*[1]"
               position="before">
            <t t-set="facodi_catalog_visuals"
               t-value="channels._facodi_catalog_visuals()"/>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'row-cols-1')]"
               position="attributes">
            <attribute name="t-attf-class">facodi-slides-grid</attribute>
        </xpath>
    </template>

    <template id="facodi_course_card"
              inherit_id="website_slides.course_card"
              name="FACODI Course Card Visual">
        <xpath expr="//div[@t-field='channel.image_1920']" position="replace">
            <t t-set="facodi_visual" t-value="facodi_catalog_visuals.get(channel.id)"/>
            <div class="facodi-course-media ratio ratio-16x9">
                <img t-if="facodi_visual and facodi_visual.get('kind') == 'channel'"
                     t-att-src="'/web/image/slide.channel/%s/image_512' % channel.id"
                     t-att-alt="channel.name or 'FACODI course'"
                     loading="lazy"
                     decoding="async"/>
                <img t-elif="facodi_visual and facodi_visual.get('kind') == 'slide'"
                     t-att-src="'/web/image/slide.slide/%s/image_512' % facodi_visual['slide'].id"
                     t-att-alt="facodi_visual.get('alt') or channel.name or 'FACODI course'"
                     loading="lazy"
                     decoding="async"/>
                <img t-elif="facodi_visual and facodi_visual.get('kind') == 'youtube'"
                     t-att-src="facodi_visual.get('url')"
                     t-att-alt="facodi_visual.get('alt') or channel.name or 'FACODI course'"
                     loading="lazy"
                     decoding="async"
                     referrerpolicy="strict-origin-when-cross-origin"/>
                <div t-else=""
                     class="facodi-course-fallback"
                     aria-hidden="true">
                    <span class="facodi-course-fallback-brand" t-translation="off">FACODI.</span>
                    <strong t-out="(channel.name or '')[:2].upper()"/>
                    <i class="fa fa-book" aria-hidden="true" t-translation="off"/>
                </div>
            </div>
        </xpath>
    </template>

    <template id="facodi_training_content_type_cue"
              inherit_id="website_slides.course_slides_list_slide"
              name="FACODI Training Content Type Cue">
        <xpath expr="//a[contains(concat(' ', normalize-space(@class), ' '), ' o_wslides_js_slides_list_slide_link ')]"
               position="inside">
            <t t-set="facodi_category_label"
               t-value="dict(slide._fields['slide_category']._description_selection(slide.env)).get(slide.slide_category, slide.slide_category)"/>
            <span t-attf-class="facodi-content-type facodi-content-type-#{slide.slide_category} badge rounded-pill ms-2"
                  t-out="facodi_category_label"/>
        </xpath>
    </template>

    <template id="facodi_documentation_content_type_cue"
              inherit_id="website_slides.lesson_card"
              name="FACODI Documentation Content Type Cue">
        <xpath expr="//div[@t-field='slide.image_1920']" position="replace">
            <img t-if="slide.image_1920"
                 t-att-src="'/web/image/slide.slide/%s/image_512' % slide.id"
                 t-att-alt="slide.name or ''"
                 class="w-100 h-100 facodi-lesson-media"
                 loading="lazy"
                 decoding="async"/>
            <img t-elif="slide.youtube_id"
                 t-att-src="'https://i.ytimg.com/vi/%s/hqdefault.jpg' % slide.youtube_id"
                 t-att-alt="slide.name or ''"
                 class="w-100 h-100 facodi-lesson-media"
                 loading="lazy"
                 decoding="async"
                 referrerpolicy="strict-origin-when-cross-origin"/>
            <div t-else=""
                 class="w-100 h-100 o_wslides_lesson_card_image facodi-lesson-fallback text-center d-flex align-items-center justify-content-center"
                 aria-hidden="true">
                <i t-attf-class="fa #{slide.slide_icon_class} fa-3x"/>
            </div>
        </xpath>
        <xpath expr="//div[contains(concat(' ', normalize-space(@class), ' '), ' card-body ')]/*[1]" position="before">
            <t t-set="facodi_category_label"
               t-value="dict(slide._fields['slide_category']._description_selection(slide.env)).get(slide.slide_category, slide.slide_category)"/>
            <span t-attf-class="facodi-content-type facodi-content-type-#{slide.slide_category} badge rounded-pill mb-2 align-self-start">
                <i t-attf-class="fa #{slide.slide_icon_class} me-1" aria-hidden="true"/>
                <span t-out="facodi_category_label"/>
            </span>
        </xpath>
    </template>
</odoo>