msgstr "Voir comment fonctionne le bureau"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "FACODI principles at a glance"
msgstr "Les principes FACODI en un coup d’œil"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Open by default"
msgstr "Ouvert par défaut"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Public resources first."
msgstr "Les ressources publiques d’abord."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Useful learning should be reachable without a paywall maze."
msgstr "Un apprentissage utile doit rester accessible sans labyrinthe de paywalls."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Context, not claims"
msgstr "Du contexte, pas des promesses"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Map the learning. Keep the boundary clear."
msgstr "Cartographier l’apprentissage. Garder les limites claires."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Curricular references guide navigation; they do not create equivalence or academic credit."
msgstr "Les références curriculaires guident la navigation ; elles ne créent ni équivalence ni crédits académiques."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Built in public"
msgstr "Construit en public"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Good finds can travel."
msgstr "Les bonnes découvertes peuvent circuler."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.s_facodi_about_hero
msgid "Community suggestions can move through review and become useful shared learning context."
msgstr "Les suggestions de la communauté peuvent être révisées et devenir un contexte d’apprentissage partagé utile."

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.new_page_template_sections_facodi_about
msgid "The house rules"
msgstr "Les règles de la maison"

#. module: theme_facodi
#: model_terms:theme.ir.ui.view,arch:theme_facodi.new_page_template_sections_facodi_about
msgid "Open learning, with fewer mystery boxes."
msgstr "Apprentissage ouvert, avec moins de boîtes mystères."

